# ── Datasets ────────────────────────────────────────────────────────────────
# Stored in S3 (DATASETS_BUCKET). Downloaded at CI/CD time; never committed.
/datasets/*

# ── Model artifacts ─────────────────────────────────────────────────────────
# Regenerated by train.py; published via the model registry (model_registry.py).
*.joblib
/model/evaluation.json
/model/drift_baseline.json

# ── Runtime / monitoring ─────────────────────────────────────────────────────
/monitoring/

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd

# ── Test & coverage ──────────────────────────────────────────────────────────
.pytest_cache/
.coverage
coverage.xml
htmlcov/
pytest-report.xml

# ── Editors & OS ─────────────────────────────────────────────────────────────
.env
.venv
venv/
*.egg-info/
dist/
build/
.DS_Store
Thumbs.db
